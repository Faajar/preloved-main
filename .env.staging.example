APP_NAME="Preloved IN (Staging)"
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_URL=https://staging.preloved.example

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# MySQL Staging Database
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=preloved_staging
DB_USERNAME=preloved_user
DB_PASSWORD=secret_staging_password
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
DB_ENGINE=InnoDB

# Session, Cache & Queue (Database driver)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database

# Mail (Gunakan mailhog / mailpit / mailtrap untuk staging)
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@staging.preloved.example"
MAIL_FROM_NAME="${APP_NAME}"

# DOKU Sandbox Configuration (Untuk testing pembayaran di staging)
DOKU_BASE_URL=https://api-sandbox.doku.com
DOKU_CLIENT_ID=MCH-STAGING-001
DOKU_SECRET_KEY=SK-STAGING-SECRET
DOKU_PAYMENT_DUE_MINUTES=60
DOKU_WEBHOOK_TOLERANCE_SECONDS=300
DOKU_CONNECT_TIMEOUT_SECONDS=5
DOKU_TIMEOUT_SECONDS=15
DOKU_ALLOWED_CHECKOUT_HOSTS=sandbox.doku.com

VITE_APP_NAME="${APP_NAME}"
